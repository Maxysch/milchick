SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
PORT=3001

# Orígenes autorizados a llamar a la API, separados por coma. Vacío acepta
# cualquiera: alcanza en desarrollo, donde Vite hace de proxy y nunca hay
# cross-origin. En producción va la URL del frontend, por ejemplo
# https://milchick.netlify.app
CORS_ORIGIN=

# URL del servicio de agentes LangChain. Es opcional: sin él la app funciona
# entera salvo los chats de normalización y liquidación
AGENT_SERVICE_URL=http://localhost:3002

# Zona horaria de la operación. Las marcaciones del portal se registran con esta
# hora y es la que define "hoy", esté donde esté el servidor (Vercel corre en
# UTC). Es opcional: por defecto, America/Argentina/Buenos_Aires
APP_TIMEZONE=
